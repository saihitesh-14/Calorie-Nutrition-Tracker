rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Common Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Extract incoming/existing resource state
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // User Entity Verification
    function isValidUser(data) {
      return data.keys().hasAll(['userId', 'gender', 'age', 'height', 'weight', 'goal', 'targetCalories', 'targetProtein', 'targetCarbs', 'targetFat', 'updatedAt'])
        && data.keys().size() == 11
        && data.userId == request.auth.uid
        && data.gender is string && (data.gender == 'male' || data.gender == 'female' || data.gender == 'other')
        && data.age is int && data.age >= 0 && data.age <= 120
        && data.height is number && data.height >= 0 && data.height <= 300
        && data.weight is number && data.weight >= 0 && data.weight <= 500
        && data.goal is string && data.goal.size() <= 100
        && data.targetCalories is number && data.targetCalories >= 0 && data.targetCalories <= 20000
        && data.targetProtein is number && data.targetProtein >= 0 && data.targetProtein <= 2000
        && data.targetCarbs is number && data.targetCarbs >= 0 && data.targetCarbs <= 2000
        && data.targetFat is number && data.targetFat >= 0 && data.targetFat <= 1000
        && data.updatedAt is string && data.updatedAt.size() <= 128;
    }

    // Log Entity Verification
    function isValidLog(data) {
      return data.keys().hasAll(['id', 'userId', 'foodName', 'mealType', 'calories', 'protein', 'carbs', 'fat', 'loggedAt', 'createdAt'])
        && data.keys().size() >= 10 && data.keys().size() <= 12
        && data.id is string && data.id.size() <= 128
        && data.userId == request.auth.uid
        && data.foodName is string && data.foodName.size() <= 200
        && data.mealType is string && (data.mealType == 'breakfast' || data.mealType == 'lunch' || data.mealType == 'dinner' || data.mealType == 'snack')
        && data.calories is number && data.calories >= 0 && data.calories <= 10000
        && data.protein is number && data.protein >= 0 && data.protein <= 1000
        && data.carbs is number && data.carbs >= 0 && data.carbs <= 1000
        && data.fat is number && data.fat >= 0 && data.fat <= 500
        && (!('ingredients' in data) || (data.ingredients is list && data.ingredients.size() <= 50 && (data.ingredients.size() == 0 || data.ingredients[0] is string)))
        && (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 2000000))
        && data.loggedAt is string && data.loggedAt.size() <= 128
        && data.createdAt is string && data.createdAt.size() <= 128;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId;
      allow create, update: if isSignedIn() && request.auth.uid == userId && isValidUser(incoming());
      allow delete: if isSignedIn() && request.auth.uid == userId;

      match /logs/{logId} {
        allow get, list: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn() && request.auth.uid == userId && isValidId(logId) && isValidLog(incoming());
        allow update: if isSignedIn() && request.auth.uid == userId && isValidId(logId) && isValidLog(incoming());
        allow delete: if isSignedIn() && request.auth.uid == userId;
      }
    }
  }
}
