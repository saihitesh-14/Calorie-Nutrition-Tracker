      url: "https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQESTxqU0mHlVE9RyzAuEfTdUvjWrUhYpPwhymLqHGPxDUh8AFqn33L03VVuQowRio3Pqu-W-GJebrRFpQykQ0C04u4bqNoxr1ES2U2ovKGwzlLfUyq5Poa5R6Gptx4wTJzVWyT3EVXtEUwhEMBKqr1gGh_8yx9_6seC4ilGvyr1TsPulrHInKAx76kLdhdoFunYUrr3EFI1odreS6tjCeDcbey2cw=="
