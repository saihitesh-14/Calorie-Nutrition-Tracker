    replacement_chunks {
      target_content: "          {/* Bento Card 1: Main Calorie Progress wheel */}\n          <div className=\"lg:col-span-5 bg-white border border-slate-150/70 p-6 rounded-3xl shadow-xs flex flex-col justify-between\">\n            <div className=\"flex items-center justify-between mb-4\">\n              <div>\n                <h3 className=\"font-bold text-slate-800 text-sm\">Caloric Balance</h3>\n                <p className=\"text-xs text-slate-400 font-mono mt-0.5\">TODAY\'S METRIC REPORT</p>\n              </div>\n              <input\n                type=\"date\"\n                value={selectedDateFilter}\n                onChange={(e) => setSelectedDateFilter(e.target.value)}\n                className=\"h-8 px-2 border border-slate-200 rounded-lg text-xs font-medium text-slate-600 focus:outline-none\"\n              />\n            </div>\n\n            {/* Middle Calorie Dials */}\n            <div className=\"flex items-center gap-6 py-2\">\n              <div id=\"radial-progress\" className=\"relative w-28 h-28 shrink-0 flex items-center justify-center\">\n                {/* SVG Progress Circle */}\n                <svg className=\"w-full h-full transform -rotate-90\">\n                  <circle\n                    cx=\"56\"\n                    cy=\"56\"\n                    r=\"48\"\n                    className=\"stroke-slate-100\"\n                    strokeWidth=\"8\"\n                    fill=\"transparent\"\n                  />\n                  <circle\n                    cx=\"56\"\n                    cy=\"56\"\n                    r=\"48\"\n                    className=\"stroke-emerald-500 transition-all duration-500\"\n                    strokeWidth=\"8\"\n                    fill=\"transparent\"\n                    strokeDasharray={2 * Math.PI * 48}\n                    strokeDashoffset={2 * Math.PI * 48 * (1 - caloriePercent / 100)}\n                    strokeLinecap=\"round\"\n                  />\n                </svg>\n                {/* Text inside */}\n                <div className=\"absolute text-center leading-none\">\n                  <span className=\"text-2xl font-extrabold text-slate-800\">{caloriePercent}%</span>\n                  <span className=\"text-[10px] text-slate-400 font-mono block mt-0.5\">filled</span>\n                </div>\n              </div>\n\n              <div className=\"space-y-1.5 flex-1\">\n                <div>\n                  <span className=\"text-[10px] font-semibold text-slate-400 block uppercase font-mono\">Calories Consumed</span>\n                  <strong className=\"text-3xl font-black text-slate-800\">{totalCalories}</strong>\n                  <span className=\"text-xs text-slate-400 font-mono font-medium ml-1\">kcal</span>\n                </div>\n                <div className=\"pt-1.5 border-t border-slate-100 flex items-center justify-between text-xs\">\n                  <span className=\"text-slate-400 font-medium\">Daily Budget:</span>\n                  <strong className=\"text-slate-700 font-bold\">{profile.targetCalories} kcal</strong>\n                </div>\n              </div>\n            </div>\n\n            {/* Goal recommendation banner */}\n            <div className=\"mt-4 p-3.5 bg-slate-50 border border-slate-100 rounded-2xl flex items-start gap-2.5 text-xs text-slate-600 leading-normal\">\n              <Flame size={15} className=\"text-emerald-600 shrink-0 mt-0.5 animate-pulse\" />\n              <div>\n                <span>You chose a target to <strong>{profile.goal}</strong>. </span>\n                {totalCalories > profile.targetCalories ? (\n                  <span className=\"text-rose-600 font-medium\">You have exceeded your daily limit. Slow down calorie intake.</span>\n                ) : (\n                  <span className=\"text-emerald-700 font-medium\">Keep tracking meals to hit nutritional guidelines.</span>\n                )}\n              </div>\n            </div>\n          </div>\n\n          {/* Bento Card 2: Macronutrients limits */}\n          <div className=\"lg:col-span-4 bg-white border border-slate-150/70 p-6 rounded-3xl shadow-xs flex flex-col justify-between\">\n            <div>\n              <h3 className=\"font-bold text-slate-800 text-sm\">Macronutrient Dials</h3>\n              <p className=\"text-xs text-slate-400 font-mono mt-0.5\">BALANCED MACROS TARGET</p>\n            </div>\n\n            {/* Macro bars list */}\n            <div className=\"space-y-4 my-4\">\n              {/* Protein bar */}\n              <div className=\"space-y-1\">\n                <div className=\"flex items-center justify-between text-xs\">\n                  <div className=\"flex items-center gap-1.5\">\n                    <span className=\"w-2.5 h-2.5 rounded-full bg-rose-500\"></span>\n                    <span className=\"font-semibold text-slate-700 text-[11px]\">Protein</span>\n                  </div>\n                  <span className=\"text-[10px] text-slate-505 font-mono\">\n                    <strong>{totalProtein}g</strong> / {profile.targetProtein}g\n                  </span>\n                </div>\n                <div className=\"h-2 w-full bg-slate-100 rounded-full overflow-hidden\">\n                  <div className=\"h-full bg-rose-500 rounded-full transition-all duration-300\" style={{ width: `${proteinPercent}%` }}></div>\n                </div>\n              </div>\n\n              {/* Carbs bar */}\n              <div className=\"space-y-1\">\n                <div className=\"flex items-center justify-between text-xs\">\n                  <div className=\"flex items-center gap-1.5\">\n                    <span className=\"w-2.5 h-2.5 rounded-full bg-amber-500\"></span>\n                    <span className=\"font-semibold text-slate-700 text-[11px]\">Carbohydrates</span>\n                  </div>\n                  <span className=\"text-[10px] text-slate-505 font-mono\">\n                    <strong>{totalCarbs}g</strong> / {profile.targetCarbs}g\n                  </span>\n                </div>\n                <div className=\"h-2 w-full bg-slate-100 rounded-full overflow-hidden\">\n                  <div className=\"h-full bg-amber-500 rounded-full transition-all duration-300\" style={{ width: `${carbsPercent}%` }}></div>\n                </div>\n              </div>\n\n              {/* Fats bar */}\n              <div className=\"space-y-1\">\n                <div className=\"flex items-center justify-between text-xs\">\n                  <div className=\"flex items-center gap-1.5\">\n                    <span className=\"w-2.5 h-2.5 rounded-full bg-sky-500\"></span>\n                    <span className=\"font-semibold text-slate-700 text-[11px]\">Lipids / Fat</span>\n                  </div>\n                  <span className=\"text-[10px] text-slate-505 font-mono\">\n                    <strong>{totalFat}g</strong> / {profile.targetFat}g\n                  </span>\n                </div>\n                <div className=\"h-2 w-full bg-slate-100 rounded-full overflow-hidden\">\n                  <div className=\"h-full bg-sky-500 rounded-full transition-all duration-300\" style={{ width: `${fatPercent}%` }}></div>\n                </div>\n              </div>\n            </div>\n\n            <div className=\"flex items-center justify-between text-[11px] text-slate-400 font-mono border-t border-slate-100 pt-3\">\n              <span>Goal: high protein protecting mass</span>\n              <span className=\"text-emerald-600 font-semibold uppercase\">Clean Plan</span>\n            </div>\n          </div>\n\n          {/* Bento Card 3: Profile attributes */}\n          <div className=\"lg:col-span-3 bg-slate-900 border border-slate-950 p-6 rounded-3xl shadow-lg flex flex-col justify-between text-white\">\n            <div className=\"flex items-start justify-between\">\n              <div>\n                <span className=\"text-[9px] font-semibold text-emerald-400 uppercase tracking-wider font-mono\">User Settings</span>\n                <h3 className=\"font-bold text-sm text-slate-100 font-sans mt-0.5\">Biometric Identity</h3>\n              </div>\n              <div className=\"w-8 h-8 rounded-xl bg-slate-800 flex items-center justify-center text-emerald-400\">\n                <User size={16} />\n              </div>\n            </div>\n\n            {/* Metrics grid statistics */}\n            <div className=\"grid grid-cols-2 gap-3 my-4\">\n              <div className=\"bg-slate-850 p-3 rounded-2xl border border-slate-800\">\n                <span className=\"text-[9px] text-slate-400 font-mono uppercase\">Weight</span>\n                <strong className=\"text-lg font-extrabold text-white block mt-0.5\">{profile.weight} kg</strong>\n              </div>\n              <div className=\"bg-slate-850 p-3 rounded-2xl border border-slate-800\">\n                <span className=\"text-[9px] text-slate-400 font-mono uppercase\">Height</span>\n                <strong className=\"text-lg font-extrabold text-white block mt-0.5\">{profile.height} cm</strong>\n              </div>\n              <div className=\"bg-slate-850 p-3 rounded-2xl border border-slate-800\">\n                <span className=\"text-[9px] text-slate-400 font-mono uppercase\">Age</span>\n                <strong className=\"text-lg font-extrabold text-white block mt-0.5\">{profile.age} yrs</strong>\n              </div>\n              <div className=\"bg-slate-850 p-3 rounded-2xl border border-slate-800\">\n                <span className=\"text-[9px] text-slate-400 font-mono uppercase\">Target Goal</span>\n                <strong className=\"text-xs font-bold text-white capitalize block mt-1.5 truncate text-emerald-400\">{profile.goal}</strong>\n              </div>\n            </div>\n\n            <button\n              onClick={onResetOnboarding}\n              className=\"w-full h-9 bg-slate-800 hover:bg-slate-700 text-slate-200 hover:text-white rounded-xl text-xs font-semibold cursor-pointer transition-colors border border-slate-700\"\n            >\n              Reset Biometric Settings\n            </button>\n          </div>\n\n        </div>\n\n        {/* LOG MEAL BUTTON BAR */}\n        <div className=\"flex items-center justify-between bg-white border border-slate-150/70 p-5 rounded-3xl shrink-0\">\n          <div>\n            <h3 className=\"font-bold text-slate-800 text-sm font-sans\">\n              Ready to enrich your journal?\n            </h3>\n            <p className=\"text-xs text-slate-400 leading-normal\">\n              Commit photos of breakfast, lunch, or dinner, and allow Gemini to extract nutritional counts instantly.\n            </p>\n          </div>\n          <button\n            onClick={onAddNewMeal}\n            className=\"h-11 px-5 bg-emerald-600 hover:bg-emerald-700 text-white rounded-2xl text-xs font-bold flex items-center gap-1.5 cursor-pointer shadow-md shadow-emerald-100 transition-colors\"\n          >\n            <Plus size={16} strokeWidth={2} /> Log Daily Meal\n          </button>\n        </div>\n\n        {/* Dynamic Trends Graph (Middle Block) */}\n        <div className=\"bg-white border border-slate-150/70 rounded-3xl p-6 shadow-xs\">\n          <div className=\"flex items-center justify-between mb-6\">\n            <div>\n              <h3 className=\"font-bold text-slate-800 text-sm\">7-Day Caloric Intake Trends</h3>\n              <p className=\"text-xs text-slate-400 font-mono mt-0.5\">DAILY INTAKE VS GOAL TARGET LIMITS</p>\n            </div>\n            \n            <div className=\"flex items-center gap-1 bg-slate-50 border border-slate-200/80 px-3 py-1 rounded-full text-[10px] text-slate-500 font-mono font-bold tracking-tight\">\n              <TrendingUp size={10} className=\"text-emerald-500 shrink-0\" /> METABOLIC HISTORY\n            </div>\n          </div>"
      replacement_content: "          {/* Bento Card 1: Main Calorie Progress wheel */}\n          <div className=\"lg:col-span-5 bg-white dark:bg-slate-900 border border-slate-150/70 dark:border-slate-800 p-6 rounded-3xl shadow-xs flex flex-col justify-between transition-colors duration-300\">\n            <div className=\"flex items-center justify-between mb-4\">\n              <div>\n                <h3 className=\"font-bold text-slate-850 dark:text-slate-100 text-sm\">Caloric Balance</h3>\n                <p className=\"text-xs text-slate-400 dark:text-slate-500 font-mono mt-0.5\">TODAY\'S METRIC REPORT</p>\n              </div>\n              <input\n                type=\"date\"\n                value={selectedDateFilter}\n                onChange={(e) => setSelectedDateFilter(e.target.value)}\n                className=\"h-8 px-2 border border-slate-200 dark:border-slate-700 rounded-lg text-xs font-medium text-slate-650 dark:text-slate-300 bg-white dark:bg-slate-800 focus:outline-none focus:ring-1 focus:ring-emerald-500\"\n              />\n            </div>\n\n            {/* Middle Calorie Dials */}\n            <div className=\"flex items-center gap-6 py-2\">\n              <div id=\"radial-progress\" className=\"relative w-28 h-28 shrink-0 flex items-center justify-center\">\n                {/* SVG Progress Circle */}\n                <svg className=\"w-full h-full transform -rotate-90\">\n                  <circle\n                    cx=\"56\"\n                    cy=\"56\"\n                    r=\"48\"\n                    className=\"stroke-slate-100 dark:stroke-slate-800\"\n                    strokeWidth=\"8\"\n                    fill=\"transparent\"\n                  />\n                  <circle\n                    cx=\"56\"\n                    cy=\"56\"\n                    r=\"48\"\n                    className=\"stroke-emerald-500 transition-all duration-500\"\n                    strokeWidth=\"8\"\n                    fill=\"transparent\"\n                    strokeDasharray={2 * Math.PI * 48}\n                    strokeDashoffset={2 * Math.PI * 48 * (1 - caloriePercent / 100)}\n                    strokeLinecap=\"round\"\n                  />\n                </svg>\n                {/* Text inside */}\n                <div className=\"absolute text-center leading-none\">\n                  <span className=\"text-2xl font-extrabold text-slate-850 dark:text-slate-50\">{caloriePercent}%</span>\n                  <span className=\"text-[10px] text-slate-400 dark:text-slate-500 font-mono block mt-0.5\">filled</span>\n                </div>\n              </div>\n\n              <div className=\"space-y-1.5 flex-1\">\n                <div>\n                  <span className=\"text-[10px] font-semibold text-slate-400 dark:text-slate-500 block uppercase font-mono\">Calories Consumed</span>\n                  <strong className=\"text-3xl font-black text-slate-850 dark:text-slate-50\">{totalCalories}</strong>\n                  <span className=\"text-xs text-slate-400 dark:text-slate-550 font-mono font-medium ml-1\">kcal</span>\n                </div>\n                <div className=\"pt-1.5 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between text-xs\">\n                  <span className=\"text-slate-400 dark:text-slate-500 font-medium\">Daily Budget:</span>\n                  <strong className=\"text-slate-700 dark:text-slate-300 font-bold\">{profile.targetCalories} kcal</strong>\n                </div>\n              </div>\n            </div>\n\n            {/* Goal recommendation banner */}\n            <div className=\"mt-4 p-3.5 bg-slate-50 dark:bg-slate-950 border border-slate-100 dark:border-slate-850 rounded-2xl flex items-start gap-2.5 text-xs text-slate-650 dark:text-slate-350 leading-normal transition-colors duration-300\">\n              <Flame size={15} className=\"text-emerald-500 shrink-0 mt-0.5 animate-pulse\" />\n              <div>\n                <span>You chose a target to <strong>{profile.goal}</strong>. </span>\n                {totalCalories > profile.targetCalories ? (\n                  <span className=\"text-rose-500 font-semibold\">You have exceeded your daily limit. Slow down calorie intake.</span>\n                ) : (\n                  <span className=\"text-emerald-600 dark:text-emerald-400 font-semibold\">Keep tracking meals to hit nutritional guidelines.</span>\n                )}\n              </div>\n            </div>\n          </div>\n\n          {/* Bento Card 2: Macronutrients limits */}\n          <div className=\"lg:col-span-4 bg-white dark:bg-slate-900 border border-slate-150/70 dark:border-slate-800 p-6 rounded-3xl shadow-xs flex flex-col justify-between transition-colors duration-300\">\n            <div>\n              <h3 className=\"font-bold text-slate-850 dark:text-slate-100 text-sm\">Macronutrient Dials</h3>\n              <p className=\"text-xs text-slate-400 dark:text-slate-500 font-mono mt-0.5\">BALANCED MACROS TARGET</p>\n            </div>\n\n            {/* Macro bars list */}\n            <div className=\"space-y-4 my-4\">\n              {/* Protein bar */}\n              <div className=\"space-y-1\">\n                <div className=\"flex items-center justify-between text-xs\">\n                  <div className=\"flex items-center gap-1.5\">\n                    <span className=\"w-2.5 h-2.5 rounded-full bg-rose-500\"></span>\n                    <span className=\"font-semibold text-slate-700 dark:text-slate-300 text-[11px]\">Protein</span>\n                  </div>\n                  <span className=\"text-[10px] text-slate-450 dark:text-slate-400 font-mono\">\n                    <strong className=\"text-slate-800 dark:text-slate-200\">{totalProtein}g</strong> / {profile.targetProtein}g\n                  </span>\n                </div>\n                <div className=\"h-2 w-full bg-slate-100 dark:bg-slate-800 rounded-full overflow-hidden\">\n                  <div className=\"h-full bg-rose-500 rounded-full transition-all duration-300\" style={{ width: `${proteinPercent}%` }}></div>\n                </div>\n              </div>\n\n              {/* Carbs bar */}\n              <div className=\"space-y-1\">\n                <div className=\"flex items-center justify-between text-xs\">\n                  <div className=\"flex items-center gap-1.5\">\n                    <span className=\"w-2.5 h-2.5 rounded-full bg-amber-500\"></span>\n                    <span className=\"font-semibold text-slate-700 dark:text-slate-300 text-[11px]\">Carbohydrates</span>\n                  </div>\n                  <span className=\"text-[10px] text-slate-450 dark:text-slate-400 font-mono\">\n                    <strong className=\"text-slate-800 dark:text-slate-200\">{totalCarbs}g</strong> / {profile.targetCarbs}g\n                  </span>\n                </div>\n                <div className=\"h-2 w-full bg-slate-100 dark:bg-slate-800 rounded-full overflow-hidden\">\n                  <div className=\"h-full bg-amber-500 rounded-full transition-all duration-300\" style={{ width: `${carbsPercent}%` }}></div>\n                </div>\n              </div>\n\n              {/* Fats bar */}\n              <div className=\"space-y-1\">\n                <div className=\"flex items-center justify-between text-xs\">\n                  <div className=\"flex items-center gap-1.5\">\n                    <span className=\"w-2.5 h-2.5 rounded-full bg-sky-500\"></span>\n                    <span className=\"font-semibold text-slate-700 dark:text-slate-300 text-[11px]\">Lipids / Fat</span>\n                  </div>\n                  <span className=\"text-[10px] text-slate-450 dark:text-slate-400 font-mono\">\n                    <strong className=\"text-slate-800 dark:text-slate-200\">{totalFat}g</strong> / {profile.targetFat}g\n                  </span>\n                </div>\n                <div className=\"h-2 w-full bg-slate-100 dark:bg-slate-800 rounded-full overflow-hidden\">\n                  <div className=\"h-full bg-sky-500 rounded-full transition-all duration-300\" style={{ width: `${fatPercent}%` }}></div>\n                </div>\n              </div>\n            </div>\n\n            <div className=\"flex items-center justify-between text-[11px] text-slate-400 dark:text-slate-500 font-mono border-t border-slate-100 dark:border-slate-800 pt-3\">\n              <span>Goal: high protein protecting mass</span>\n              <span className=\"text-emerald-500 font-semibold uppercase\">Clean Plan</span>\n            </div>\n          </div>\n\n          {/* Bento Card 3: Profile attributes */}\n          <div className=\"lg:col-span-3 bg-slate-900 dark:bg-slate-900 border border-slate-950 dark:border-slate-800 p-6 rounded-3xl shadow-lg flex flex-col justify-between text-white transition-colors duration-300\">\n            <div className=\"flex items-start justify-between\">\n              <div>\n                <span className=\"text-[9px] font-semibold text-emerald-400 uppercase tracking-wider font-mono\">User Settings</span>\n                <h3 className=\"font-bold text-sm text-slate-100 font-sans mt-0.5\">Biometric Identity</h3>\n              </div>\n              <div className=\"w-8 h-8 rounded-xl bg-slate-800 flex items-center justify-center text-emerald-400\">\n                <User size={16} />\n              </div>\n            </div>\n\n            {/* Metrics grid statistics */}\n            <div className=\"grid grid-cols-2 gap-3 my-4\">\n              <div className=\"bg-slate-850 dark:bg-slate-950/40 p-3 rounded-2xl border border-slate-800/60\">\n                <span className=\"text-[9px] text-slate-450 font-mono uppercase\">Weight</span>\n                <strong className=\"text-lg font-extrabold text-white block mt-0.5\">{profile.weight} kg</strong>\n              </div>\n              <div className=\"bg-slate-850 dark:bg-slate-950/40 p-3 rounded-2xl border border-slate-800/60\">\n                <span className=\"text-[9px] text-slate-450 font-mono uppercase\">Height</span>\n                <strong className=\"text-lg font-extrabold text-white block mt-0.5\">{profile.height} cm</strong>\n              </div>\n              <div className=\"bg-slate-850 dark:bg-slate-950/40 p-3 rounded-2xl border border-slate-800/60\">\n                <span className=\"text-[9px] text-slate-450 font-mono uppercase\">Age</span>\n                <strong className=\"text-lg font-extrabold text-white block mt-0.5\">{profile.age} yrs</strong>\n              </div>\n              <div className=\"bg-slate-850 dark:bg-slate-950/40 p-3 rounded-2xl border border-slate-800/60\">\n                <span className=\"text-[9px] text-slate-450 font-mono uppercase\">Target Goal</span>\n                <strong className=\"text-xs font-bold text-white capitalize block mt-1.5 truncate text-emerald-400\">{profile.goal}</strong>\n              </div>\n            </div>\n\n            <button\n              onClick={onResetOnboarding}\n              className=\"w-full h-9 bg-slate-800 dark:bg-slate-950/50 hover:bg-slate-700 dark:hover:bg-slate-850 text-slate-200 hover:text-white rounded-xl text-xs font-semibold cursor-pointer transition-colors border border-slate-700 dark:border-slate-800\"\n            >\n              Reset Biometric Settings\n            </button>\n          </div>\n\n        </div>\n\n        {/* LOG MEAL BUTTON BAR */}\n        <div className=\"flex flex-col sm:flex-row gap-4 items-center justify-between bg-white dark:bg-slate-900 border border-slate-150/70 dark:border-slate-800 p-5 rounded-3xl shrink-0 transition-colors duration-300\">\n          <div>\n            <h3 className=\"font-bold text-slate-850 dark:text-slate-100 text-sm font-sans\">\n              Ready to enrich your journal?\n            </h3>\n            <p className=\"text-xs text-slate-400 dark:text-slate-500 leading-normal\">\n              Commit photos of breakfast, lunch, or dinner, and