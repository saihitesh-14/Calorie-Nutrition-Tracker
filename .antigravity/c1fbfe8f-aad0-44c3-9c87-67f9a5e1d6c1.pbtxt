        }
        lines {
          text: "      if (isNaN(parsedHeight) || parsedHeight < 100 || parsedHeight > 250) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        setErrorString(\'Please enter a realistic height between 100cm and 250cm.\');"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        return;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      if (isNaN(parsedWeight) || parsedWeight < 30 || parsedWeight > 250) {"
