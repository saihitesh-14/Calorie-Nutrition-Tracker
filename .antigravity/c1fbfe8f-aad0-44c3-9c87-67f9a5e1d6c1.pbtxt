    replacement_infos {
      original_chunk {
        target_content: "                {/* Meta Selectors (Meal Type & Date) */}\n                <div className=\"grid grid-cols-2 gap-3\">\n                  <div>\n                    <label className=\"block text-[10px] uppercase font-mono font-bold tracking-wider text-slate-400 mb-1.5 flex items-center gap-1\">\n                      <Activity size={10} /> Meal Category\n                    </label>\n                    <select\n                      value={mealType}\n                      onChange={(e) => setMealType(e.target.value as any)}\n                      className=\"w-full h-10 px-3 bg-slate-50 border border-slate-200 rounded-xl text-xs text-slate-700 font-medium focus:outline-none focus:ring-1 focus:ring-emerald-500\"\n                    >\n                      <option value=\"breakfast\">Breakfast</option>\n                      <option value=\"lunch\">Lunch</option>\n                      <option value=\"dinner\">Dinner</option>\n                      <option value=\"snack\">Snack</option>\n                    </select>\n                  </div>\n                  <div>\n                    <label className=\"block text-[10px] uppercase font-mono font-bold tracking-wider text-slate-400 mb-1.5 flex items-center gap-1\">\n                      <Calendar size={10} /> Meal Date\n                    </label>\n                    <input\n                      type=\"date\"\n                      value={dateString}\n                      onChange={(e) => setDateString(e.target.value)}\n                      className=\"w-full h-10 px-3 bg-slate-50 border border-slate-200 rounded-xl text-xs text-slate-700 font-medium focus:outline-none focus:ring-1 focus:ring-emerald-500\"\n                    />\n                  </div>\n                </div>\n\n                {/* Main Capture choice pane */}\n                {mode === \'choice\' && (\n                  <div className=\"space-y-3 pt-2\">\n                    <button\n                      onClick={startCamera}\n                      className=\"w-full h-24 bg-gradient-to-r from-emerald-50 to-teal-50 border border-emerald-100 hover:border-emerald-200 rounded-2xl flex items-center gap-4 px-6 cursor-pointer text-left transition-all group\"\n                    >\n                      <div className=\"w-12 h-12 bg-white rounded-xl shadow-sm border border-emerald-100 flex items-center justify-center text-emerald-600 group-hover:scale-105 transition-transform\">\n                        <Camera size={22} />\n                      </div>\n                      <div>\n                        <h4 className=\"text-sm font-semibold text-emerald-990\">Snap Photo via Device Camera</h4>\n                        <p className=\"text-xs text-emerald-650 mt-0.5\">Focus your camera on the plate. Works best on mobiles.</p>\n                      </div>\n                    </button>\n\n                    <button\n                      onClick={() => setMode(\'upload\')}\n                      className=\"w-full h-18 bg-slate-50 hover:bg-slate-100 border border-slate-200 rounded-2xl flex items-center gap-4 px-6 cursor-pointer text-left transition-all\"\n                    >\n                      <div className=\"w-10 h-10 bg-white rounded-lg border border-slate-200 flex items-center justify-center text-slate-600\">\n                        <Upload size={18} />\n                      </div>\n                      <div>\n                        <h4 className=\"text-xs font-semibold text-slate-800\">Upload from Photo Gallery</h4>\n                        <p className=\"text-[11px] text-slate-500 mt-0.5\">Select a pre-existing food photo from your system storage.</p>\n                      </div>\n                    </button>\n\n                    <button\n                      onClick={() => setMode(\'text\')}\n                      className=\"w-full h-18 bg-slate-50 hover:bg-slate-100 border border-slate-200 rounded-2xl flex items-center gap-4 px-6 cursor-pointer text-left transition-all\"\n                    >\n                      <div className=\"w-10 h-10 bg-white rounded-lg border border-slate-200 flex items-center justify-center text-slate-600\">\n                        <FileText size={18} />\n                      </div>\n                      <div>\n                        <h4 className=\"text-xs font-semibold text-slate-800\">Log via Text Description</h4>\n                        <p className=\"text-[11px] text-slate-500 mt-0.5\">Type what you had manually, e.g. \"protein bowl and dates\".</p>\n                      </div>\n                    </button>\n                  </div>\n                )}"
        replacement_content: "                {/* Meta Selectors (Meal Type & Date) */}\n                <div className=\"grid grid-cols-2 gap-3\">\n                  <div>\n                    <label className=\"block text-[10px] uppercase font-mono font-bold tracking-wider text-slate-400 dark:text-slate-500 mb-1.5 flex items-center gap-1\">\n                      <Activity size={10} /> Meal Category\n                    </label>\n                    <select\n                      value={mealType}\n                      onChange={(e) => setMealType(e.target.value as any)}\n                      className=\"w-full h-10 px-3 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-750 rounded-xl text-xs text-slate-700 dark:text-slate-200 font-medium focus:outline-none focus:ring-1 focus:ring-emerald-500\"\n                    >\n                      <option value=\"breakfast\">Breakfast</option>\n                      <option value=\"lunch\">Lunch</option>\n                      <option value=\"dinner\">Dinner</option>\n                      <option value=\"snack\">Snack</option>\n                    </select>\n                  </div>\n                  <div>\n                    <label className=\"block text-[10px] uppercase font-mono font-bold tracking-wider text-slate-400 dark:text-slate-500 mb-1.5 flex items-center gap-1\">\n                      <Calendar size={10} /> Meal Date\n                    </label>\n                    <input\n                      type=\"date\"\n                      value={dateString}\n                      onChange={(e) => setDateString(e.target.value)}\n                      className=\"w-full h-10 px-3 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-750 rounded-xl text-xs text-slate-700 dark:text-slate-200 font-medium focus:outline-none focus:ring-1 focus:ring-emerald-500\"\n                    />\n                  </div>\n                </div>\n\n                {/* Main Capture choice pane */}\n                {mode === \'choice\' && (\n                  <div className=\"space-y-3 pt-2\">\n                    <button\n                      onClick={startCamera}\n                      className=\"w-full h-24 bg-gradient-to-r from-emerald-50 to-teal-50 dark:from-emerald-950/20 dark:to-teal-950/20 border border-emerald-100 dark:border-emerald-900/50 hover:border-emerald-200 rounded-2xl flex items-center gap-4 px-6 cursor-pointer text-left transition-all group\"\n                    >\n                      <div className=\"w-12 h-12 bg-white dark:bg-slate-800 rounded-xl shadow-sm border border-emerald-100 dark:border-emerald-900 flex items-center justify-center text-emerald-600 dark:text-emerald-400 group-hover:scale-105 transition-transform\">\n                        <Camera size={22} />\n                      </div>\n                      <div>\n                        <h4 className=\"text-sm font-semibold text-emerald-900 dark:text-emerald-400\">Snap Photo via Device Camera</h4>\n                        <p className=\"text-xs text-emerald-650 dark:text-emerald-500 mt-0.5\">Focus your camera on the plate. Works best on mobiles.</p>\n                      </div>\n                    </button>\n\n                    <button\n                      onClick={() => setMode(\'upload\')}\n                      className=\"w-full h-18 bg-slate-50 dark:bg-slate-800 hover:bg-slate-100 dark:hover:bg-slate-750 border border-slate-200 dark:border-slate-750 rounded-2xl flex items-center gap-4 px-6 cursor-pointer text-left transition-all\"\n                    >\n                      <div className=\"w-10 h-10 bg-white dark:bg-slate-900 rounded-lg border border-slate-200 dark:border-slate-800 flex items-center justify-center text-slate-600 dark:text-slate-400\">\n                        <Upload size={18} />\n                      </div>\n                      <div>\n                        <h4 className=\"text-xs font-semibold text-slate-800 dark:text-slate-200\">Upload from Photo Gallery</h4>\n                        <p className=\"text-[11px] text-slate-500 dark:text-slate-400 mt-0.5\">Select a pre-existing food photo from your system storage.</p>\n                      </div>\n                    </button>\n\n                    <button\n                      onClick={() => setMode(\'text\')}\n                      className=\"w-full h-18 bg-slate-50 dark:bg-slate-800 hover:bg-slate-100 dark:hover:bg-slate-750 border border-slate-200 dark:border-slate-750 rounded-2xl flex items-center gap-4 px-6 cursor-pointer text-left transition-all\"\n                    >\n                      <div className=\"w-10 h-10 bg-white dark:bg-slate-900 rounded-lg border border-slate-200 dark:border-slate-800 flex items-center justify-center text-slate-600 dark:text-slate-400\">\n                        <FileText size={18} />\n                      </div>\n                      <div>\n                        <h4 className=\"text-xs font-semibold text-slate-800 dark:text-slate-200\">Log via Text Description</h4>\n                        <p className=\"text-[11px] text-slate-500 dark:text-slate-400 mt-0.5\">Type what you had manually, e.g. \"protein bowl and dates\".</p>\n                      </div>\n                    </button>\n                  </div>\n                )}"
