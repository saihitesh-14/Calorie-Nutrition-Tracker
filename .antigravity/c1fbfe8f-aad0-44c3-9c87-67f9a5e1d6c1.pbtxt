  file_change {
    absolute_path_uri: "file:///src/components/SummaryCard.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import { motion } from \'motion/react\';\nimport { Egg, Wheat, Droplets, Calendar, Sparkles } from \'lucide-react\';\nimport { FoodLog } from \'../types\';\n\ninterface SummaryCardProps {\n  logs: FoodLog[];\n  targetProtein?: number;\n  targetCarbs?: number;\n  targetFat?: number;\n}\n\nexport default function SummaryCard({\n  logs,\n  targetProtein = 130, // Fallback defaults if not provided\n  targetCarbs = 220,\n  targetFat = 65,\n}: SummaryCardProps) {\n  // Determine current day in local YYYY-MM-DD format\n  const todayStr = new Date().toISOString().split(\'T\')[0];\n\n  // Filter logs solely belonging to the current day\n  const todayLogs = logs.filter((log) => {\n    if (!log.loggedAt) return false;\n    return log.loggedAt.split(\'T\')[0] === todayStr;\n  });\n\n  // Calculate totals consumed today\n  const totalProtein = todayLogs.reduce((sum, log) => sum + (log.protein || 0), 0);\n  const totalCarbs = todayLogs.reduce((sum, log) => sum + (log.carbs || 0), 0);\n  const totalFat = todayLogs.reduce((sum, log) => sum + (log.fat || 0), 0);\n\n  // Compute percentages\n  const proteinPercent = Math.min(100, Math.round((totalProtein / targetProtein) * 100));\n  const carbsPercent = Math.min(100, Math.round((totalCarbs / targetCarbs) * 100));\n  const fatPercent = Math.min(100, Math.round((totalFat / targetFat) * 100));\n\n  // Count items logged\n  const loggedCount = todayLogs.length;\n\n  return (\n    <motion.div\n      id=\"summary-card-container\"\n      initial={{ opacity: 0, y: 15 }}\n      animate={{ opacity: 1, y: 0 }}\n      transition={{ duration: 0.4, ease: \'easeOut\' }}\n      className=\"bg-gradient-to-br from-slate-900 to-slate-950 dark:from-slate-900 dark:to-slate-950 text-white border border-slate-800 p-6 rounded-3xl shadow-xl space-y-6 flex flex-col justify-between\"\n    >\n      {/* Card Header */}\n      <div className=\"flex items-start justify-between\">\n        <div>\n          <span className=\"text-[10px] font-bold text-emerald-400 uppercase tracking-widest font-mono flex items-center gap-1\">\n            <Sparkles size={11} className=\"animate-pulse\" /> Today\'s Live Intake\n          </span>\n          <h3 className=\"font-extrabold text-lg text-slate-100 font-sans mt-1\">\n            Current Day Summary\n          </h3>\n        </div>\n        <div className=\"flex items-center gap-1.5 bg-slate-800/80 border border-slate-700 px-3 py-1.5 rounded-xl text-[10px] font-mono text-slate-300\">\n          <Calendar size={12} className=\"text-emerald-400\" />\n          <span>{new Date().toLocaleDateString(\'en-US\', { month: \'short\', day: \'numeric\', year: \'numeric\' })}</span>\n        </div>\n      </div>\n\n      {/* Grid of Macromolecules */}\n      <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-4\">\n        {/* Protein Stats Block */}\n        <div id=\"protein-summary-col\" className=\"bg-slate-850/60 border border-slate-805/50 p-4 rounded-2xl flex flex-col justify-between\">\n          <div className=\"flex items-center justify-between mb-3\">\n            <div className=\"flex items-center gap-1.5\">\n              <div className=\"w-7 h-7 bg-rose-500/10 border border-rose-500/20 text-rose-400 rounded-lg flex items-center justify-center\">\n                <Egg size={14} />\n              </div>\n              <span className=\"text-[11px] font-bold text-slate-300 uppercase tracking-wide\">Protein</span>\n            </div>\n            <span className=\"text-[10px] font-mono text-rose-400 font-semibold\">{proteinPercent}%</span>\n          </div>\n\n          <div className=\"space-y-2\">\n            <div>\n              <span className=\"text-2xl font-black text-rose-500 font-mono\">{totalProtein}</span>\n              <span className=\"text-xs text-slate-400 ml-0.5\">g</span>\n            </div>\n            {/* Target indicator */}\n            <div className=\"text-[9px] text-slate-450 font-mono\">\n              Target: <span className=\"font-semibold text-slate-300\">{targetProtein}g</span>\n            </div>\n            {/* Progress bar */}\n            <div className=\"h-1.5 w-full bg-slate-800/80 rounded-full overflow-hidden\">\n              <motion.div \n                initial={{ width: 0 }}\n                animate={{ width: `${proteinPercent}%` }}\n                transition={{ duration: 0.6, ease: \'easeOut\' }}\n                className=\"h-full bg-rose-500 rounded-full\"\n              />\n            </div>\n          </div>\n        </div>\n\n        {/* Carbs Stats Block */}\n        <div id=\"carbs-summary-col\" className=\"bg-slate-850/60 border border-slate-805/50 p-4 rounded-2xl flex flex-col justify-between\">\n          <div className=\"flex items-center justify-between mb-3\">\n            <div className=\"flex items-center gap-1.5\">\n              <div className=\"w-7 h-7 bg-amber-500/10 border border-amber-500/20 text-amber-400 rounded-lg flex items-center justify-center\">\n                <Wheat size={14} />\n              </div>\n              <span className=\"text-[11px] font-bold text-slate-300 uppercase tracking-wide\">Carbs</span>\n            </div>\n            <span className=\"text-[10px] font-mono text-amber-400 font-semibold\">{carbsPercent}%</span>\n          </div>\n\n          <div className=\"space-y-2\">\n            <div>\n              <span className=\"text-2xl font-black text-amber-500 font-mono\">{totalCarbs}</span>\n              <span className=\"text-xs text-slate-400 ml-0.5\">g</span>\n            </div>\n            {/* Target indicator */}\n            <div className=\"text-[9px] text-slate-450 font-mono\">\n              Target: <span className=\"font-semibold text-slate-300\">{targetCarbs}g</span>\n            </div>\n            {/* Progress bar */}\n            <div className=\"h-1.5 w-full bg-slate-800/80 rounded-full overflow-hidden\">\n              <motion.div \n                initial={{ width: 0 }}\n                animate={{ width: `${carbsPercent}%` }}\n                transition={{ duration: 0.6, ease: \'easeOut\' }}\n                className=\"h-full bg-amber-500 rounded-full\"\n              />\n            </div>\n          </div>\n        </div>\n\n        {/* Fats Stats Block */}\n        <div id=\"fat-summary-col\" className=\"bg-slate-850/60 border border-slate-805/50 p-4 rounded-2xl flex flex-col justify-between\">\n          <div className=\"flex items-center justify-between mb-3\">\n            <div className=\"flex items-center gap-1.5\">\n              <div className=\"w-7 h-7 bg-sky-500/10 border border-sky-500/20 text-sky-400 rounded-lg flex items-center justify-center\">\n                <Droplets size={14} />\n              </div>\n              <span className=\"text-[11px] font-bold text-slate-300 uppercase tracking-wide\">Fats</span>\n            </div>\n            <span className=\"text-[10px] font-mono text-sky-400 font-semibold\">{fatPercent}%</span>\n          </div>\n\n          <div className=\"space-y-2\">\n            <div>\n              <span className=\"text-2xl font-black text-sky-500 font-mono\">{totalFat}</span>\n              <span className=\"text-xs text-slate-400 ml-0.5\">g</span>\n            </div>\n            {/* Target indicator */}\n            <div className=\"text-[9px] text-slate-450 font-mono\">\n              Target: <span className=\"font-semibold text-slate-300\">{targetFat}g</span>\n            </div>\n            {/* Progress bar */}\n            <div className=\"h-1.5 w-full bg-slate-800/80 rounded-full overflow-hidden\">\n              <motion.div \n                initial={{ width: 0 }}\n                animate={{ width: `${fatPercent}%` }}\n                transition={{ duration: 0.6, ease: \'easeOut\' }}\n                className=\"h-full bg-sky-500 rounded-full\"\n              />\n            </div>\n          </div>\n        </div>\n      </div>\n\n      {/* Bottom status/logged count badge */}\n      <div className=\"flex items-center justify-between text-[11px] text-slate-400 font-mono border-t border-slate-800/60 pt-4\">\n        <span>Logged today: <strong className=\"text-slate-200\">{loggedCount} item{loggedCount !== 1 ? \'s\' : \'\'}</strong></span>\n        {loggedCount > 0 ? (\n          <span className=\"text-emerald-400 font-semibold uppercase flex items-center gap-1 animate-pulse\">\n            \342\227\217 Intake Recorded\n          </span>\n        ) : (\n          <span className=\"text-slate-500\">Waiting for logs...</span>\n        )}\n      </div>\n    </motion.div>\n  );\n}\n"
    }
