    replacement_chunks {
      target_content: "  return (\n    <div id=\"onboarding bg-wrapper\" className=\"min-h-screen flex items-center justify-center bg-slate-50 px-4 py-8\">\n      <div id=\"onboarding-card\" className=\"w-full max-w-lg bg-white rounded-3xl border border-slate-100 shadow-xl shadow-slate-50 p-8\">\n        \n        {/* Progress header bar */}\n        <div id=\"onboarding-progress-header\" className=\"flex items-center justify-between mb-8\">\n          <div className=\"flex items-center gap-2\">\n            <span className=\"w-2 h-2 rounded-full bg-emerald-500 animate-pulse\"></span>\n            <span className=\"text-[10px] uppercase font-mono tracking-wider text-slate-400\">Step {step} of 4</span>\n          </div>\n          <div id=\"progress-meter-bar\" className=\"w-24 h-1.5 bg-slate-100 rounded-full overflow-hidden\">\n            <div id=\"progress-indicator\" className=\"h-full bg-emerald-500 transition-all duration-300\" style={{ width: `${(step / 4) * 100}%` }}></div>\n          </div>\n        </div>\n\n        <AnimatePresence mode=\"wait\">\n          {step === 1 && (\n            <motion.div\n              key=\"step1\"\n              initial={{ opacity: 0, x: 10 }}\n              animate={{ opacity: 1, x: 0 }}\n              exit={{ opacity: 0, x: -10 }}\n              transition={{ duration: 0.3 }}\n              id=\"step-1-content animate\"\n            >\n              <h2 className=\"text-2xl font-bold tracking-tight text-slate-900 mb-2 font-sans flex items-center gap-2\">\n                <User size={24} className=\"text-emerald-500\" /> Let\'s get to know you\n              </h2>\n              <p className=\"text-sm text-slate-500 mb-6 font-sans\">\n                Tell us about your basic attributes. Your statistics help our system setup baseline daily energy targets.\n              </p>\n\n              {/* Gender input */}\n              <div className=\"mb-6\">\n                <label className=\"block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-3\">Biological Sex</label>\n                <div className=\"grid grid-cols-3 gap-3\">\n                  {([\'male\', \'female\', \'other\'] as const).map((g) => (\n                    <button\n                      key={g}\n                      onClick={() => setGender(g)}\n                      className={`h-11 rounded-2xl border text-sm font-medium capitalize transition-all cursor-pointer ${\n                        gender === g\n                          ? \'border-emerald-500 bg-emerald-50/40 text-emerald-700 font-semibold\'\n                          : \'border-slate-200 bg-white hover:bg-slate-50 text-slate-600\'\n                      }`}\n                    >\n                      {g}\n                    </button>\n                  ))}\n                </div>\n              </div>\n\n              {/* Age input */}\n              <div className=\"mb-6\">\n                <label className=\"block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2\">Age (years)</label>\n                <input\n                  type=\"number\"\n                  placeholder=\"e.g. 26\"\n                  value={age}\n                  onChange={(e) => setAge(e.target.value)}\n                  className=\"w-full h-12 px-4 rounded-2xl border border-slate-200 text-slate-800 text-sm focus:outline-none focus:ring-1 focus:ring-emerald-500 focus:border-emerald-500\"\n                />\n              </div>\n            </motion.div>\n          )}\n\n          {step === 2 && (\n            <motion.div\n              key=\"step2\"\n              initial={{ opacity: 0, x: 10 }}\n              animate={{ opacity: 1, x: 0 }}\n              exit={{ opacity: 0, x: -10 }}\n              transition={{ duration: 0.3 }}\n              id=\"step-2-content animate\"\n            >\n              <h2 className=\"text-2xl font-bold tracking-tight text-slate-905 mb-2 font-sans flex items-center gap-2\">\n                <Dumbbell size={24} className=\"text-emerald-500\" /> Body Metrics\n              </h2>\n              <p className=\"text-sm text-slate-500 mb-6 font-sans\">\n                Please enter your height and weight metrics to calculate your Basal Metabolic Rate (BMR).\n              </p>\n\n              {/* Height input */}\n              <div className=\"mb-6\">\n                <label className=\"block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2\">Height (cm)</label>\n                <input\n                  type=\"number\"\n                  placeholder=\"e.g. 175\"\n                  value={height}\n                  onChange={(e) => setHeight(e.target.value)}\n                  className=\"w-full h-12 px-4 rounded-2xl border border-slate-200 text-slate-800 text-sm focus:outline-none focus:ring-1 focus:ring-emerald-500 focus:border-emerald-500\"\n                />\n              </div>\n\n              {/* Weight input */}\n              <div className=\"mb-6\">\n                <label className=\"block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2\">Weight (kg)</label>\n                <input\n                  type=\"number\"\n                  step=\"0.1\"\n                  placeholder=\"e.g. 72\"\n                  value={weight}\n                  onChange={(e) => setWeight(e.target.value)}\n                  className=\"w-full h-12 px-4 rounded-2xl border border-slate-200 text-slate-800 text-sm focus:outline-none focus:ring-1 focus:ring-emerald-500 focus:border-emerald-500\"\n                />\n              </div>\n            </motion.div>\n          )}\n\n          {step === 3 && (\n            <motion.div\n              key=\"step3\"\n              initial={{ opacity: 0, x: 10 }}\n              animate={{ opacity: 1, x: 0 }}\n              exit={{ opacity: 0, x: -10 }}\n              transition={{ duration: 0.3 }}\n              id=\"step-3-content animate\"\n            >\n              <h2 className=\"text-2xl font-bold tracking-tight text-slate-905 mb-2 font-sans flex items-center gap-2\">\n                <Target size={24} className=\"text-emerald-500\" /> Choose your target\n              </h2>\n              <p className=\"text-sm text-slate-500 mb-6 font-sans\">\n                What are you looking to achieve? Based on your choice, we calibrate daily calorie restrictions.\n              </p>\n\n              <div className=\"grid grid-cols-1 gap-4 mb-6\">\n                {[\n                  {\n                    id: \'get lean\',\n                    title: \'Get Lean\',\n                    desc: \'Calorie deficit targeting maximum abdominal fat loss while preserving skeletal muscle tissue.\',\n                    icon: \'\360\237\224\245\'\n                  },\n                  {\n                    id: \'maintenance\',\n                    title: \'Maintain Weight\',\n                    desc: \'Perfect energy balance for stable metabolic functioning and performance tracking.\',\n                    icon: \'\342\232\226\357\270\217\'\n                  },\n                  {\n                    id: \'build muscle\',\n                    title: \'Build Muscle\',\n                    desc: \'Slight energy surplus paired with high protein synthesis for strength gains.\',\n                    icon: \'\360\237\222\252\'\n                  }\n                ].map((g) => (\n                  <button\n                    key={g.id}\n                    onClick={() => setGoal(g.id)}\n                    className={`p-4 rounded-2xl border text-left flex items-start gap-3 transition-all cursor-pointer ${\n                      goal === g.id\n                        ? \'border-emerald-500 bg-emerald-50/30\'\n                        : \'border-slate-200 bg-white hover:bg-slate-50\'\n                    }`}\n                  >\n                    <span className=\"text-2xl mt-0.5 shrink-0\">{g.icon}</span>\n                    <div>\n                      <h4 className={`text-sm font-semibold capitalize ${goal === g.id ? \'text-emerald-990 font-bold\' : \'text-slate-850\'}`}>{g.title}</h4>\n                      <p className=\"text-xs text-slate-500 mt-1 leading-normal\">{g.desc}</p>\n                    </div>\n                  </button>\n                ))}\n              </div>\n            </motion.div>\n          )}\n\n          {step === 4 && (\n            <motion.div\n              key=\"step4\"\n              initial={{ opacity: 0, scale: 0.98 }}\n              animate={{ opacity: 1, scale: 1 }}\n              transition={{ duration: 0.3 }}\n              id=\"step-4-content animate\"\n            >\n              <div className=\"text-center mb-6\">\n                <div className=\"mx-auto w-12 h-12 bg-emerald-50 rounded-2xl flex items-center justify-center text-emerald-600 mb-4\">\n                  <Award size={24} />\n                </div>\n                <h2 className=\"text-2xl font-bold tracking-tight text-slate-905 mb-2 font-sans\">\n                  Your customized blueprint\n                </h2>\n                <p className=\"text-sm text-slate-500 font-sans max-w-sm mx-auto\">\n                  Based on your statistics, here are your optimized baseline daily macro limits to help you <strong>{goal}</strong>:\n                </p>\n              </div>\n\n              {/* Calculated Targets Overview */}\n              {(() => {\n                const profile = calculateRequirements();\n                return (\n                  <div className=\"bg-slate-50 border border-slate-100 rounded-2xl p-6 mb-6\">\n                    {/* Calorie display */}\n                    <div className=\"text-center pb-4 border-b border-slate-100 mb-4\">\n                      <span className=\"text-xs font-semibold text-slate-400 uppercase tracking-wider block font-mono\">Daily Caloric Target</span>\n                      <strong className=\"text-4xl font-extrabold tracking-tight text-slate-905\">{profile.targetCalories}</strong>\n                      <span className=\"text-slate-500 font-medium text-xs font-mono ml-1\">kcal</span>\n                    </div>\n\n                    {/* Macros Grid */}\n                    <div className=\"grid grid-cols-3 gap-2 text-center\">\n                      <div className=\"bg-white border border-slate-100 p-3 rounded-xl\">\n                        <span className=\"text-[10px] font-semibold text-rose-450 block uppercase tracking-wider font-mono\">Protein</span>\n                        <strong className=\"text-lg font-bold text-slate-800 block mt-1\">{profile.targetProtein}g</strong>\n                        <span className=\"text-[9px] text-slate-400 font-mono\">4 kcal/g</span>\n                      </div>\n                      <div className=\"bg-white border border-slate-100 p-3 rounded-xl\">\n                        <span className=\"text-[10px] font-semibold text-amber-500 block uppercase tracking-wider font-mono\">Carbs</span>\n                        <strong className=\"text-lg font-bold text-slate-800 block mt-1\">{profile.targetCarbs}g</strong>\n                        <span className=\"text-[9px] text-slate-400 font-mono\">4 kcal/g</span>\n                      </div>\n                      <div className=\"bg-white border border-slate-100 p-3 rounded-xl\">\n                        <span className=\"text-[10px] font-semibold text-sky-500 block uppercase tracking-wider font-mono\">Fats</span>\n                        <strong className=\"text-lg font-bold text-slate-800 block mt-1\">{profile.targetFat}g</strong>\n                        <span className=\"text-[9px] text-slate-400 font-mono\">9 kcal/g</span>\n                      </div>\n                    </div>\n                  </div>\n                );\n              })()}\n            </motion.div>\n          )}\n        </AnimatePresence>\n\n        {/* Error notification banner */}\n        {errorString && (\n          <motion.div\n            initial={{ opacity: 0, y: -5 }}\n            animate={{ opacity: 1, y: 0 }}\n            className=\"p-3 bg-red-50 border border-red-100 rounded-xl mb-6 text-xs text-red-650 text-center font-medium\"\n          >\n            {errorString}\n          </motion.div>\n        )}\n\n        {/* Navigation Action Buttons footer */}\n        <div id=\"onboarding-actions\" className=\"flex items-center justify-between gap-3 mt-8\">\n          {step > 1 && step < 4 && (\n            <button\n              onClick={handleBack}\n              className=\"px-4 h-11 border border-slate-200 text-slate-600 rounded-xl flex items-center justify-center gap-1.5 text-sm hover:bg-slate-50 cursor-pointer transition-colors\"\n            >\n              <ChevronLeft size={16} />\n              <span>Back</span>\n            </button>\n          )}\n\n          <div className=\"flex-1\"></div>\n\n          {step < 4 ? (\n            <button\n              onClick={handleNext}\n              className=\"px-5 h-11 bg-slate-900 text-white rounded-xl flex items-center justify-center gap-1.5 text-sm font-medium hover:bg-slate-800 cursor-pointer transition-colors\"\n            >\n              <span>Continue</span>\n              <ChevronRight size={16} />\n            </button>\n          ) : (\n            <div className=\"flex w-full gap-3\">\n              <button\n                onClick={() => setStep(3)}\n                className=\"px-4 h-11 border border-slate-200 text-slate-600 rounded-xl text-sm hover:bg-slate-50 cursor-pointer transition-colors\"\n              >\n                Change Target\n              </button>\n              <button\n                onClick={handleSubmit}\n                className=\"flex-1 h-11 bg-emerald-600 text-white rounded-xl text-sm font-semibold hover:bg-emerald-700 cursor-pointer transition-colors\"\n              >\n                Let\'s Begin Tracking!\n              </button>\n            </div>\n          )}\n        </div>\n\n      </div>\n    </div>"
      replacement_content: "  return (\n    <div id=\"onboarding bg-wrapper\" className=\"min-h-screen flex items-center justify-center bg-slate-50 dark:bg-slate-950 px-4 py-8 transition-colors duration-300 relative\">\n      \n      {/* Floating Theme Toggle */}\n      <div className=\"absolute top-4 right-4 z-10\">\n        <button\n          onClick={onToggleTheme}\n          className=\"h-10 w-10 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 flex items-center justify-center text-slate-500 dark:text-slate-400 hover:text-slate-850 dark:hover:text-white transition-all cursor-pointer shadow-xs hover:shadow-md\"\n          title={theme === \'dark\' ? \'Switch to light mode\' : \'Switch to dark mode\'}\n        >\n          {theme === \'dark\' ? <Sun size={18} /> : <Moon size={18} />}\n        </button>\n      </div>\n\n      <div id=\"onboarding-card\" className=\"w-full max-w-lg bg-white dark:bg-slate-900 rounded-3xl border border-slate-100 dark:border-slate-800 shadow-xl dark:shadow-none p-8 transition-colors duration-300\">\n        \n        {/* Progress header bar */}\n        <div id=\"onboarding-progress-header\" className=\"flex items-center justify-between mb-8\">\n          <div className=\"flex items-center gap-2\">\n            <span className=\"w-2 h-2 rounded-full bg-emerald-500 animate-pulse\"></span>\n            <span className=\"text-[10px] uppercase font-mono tracking-wider text-slate-400 dark:text-slate-500\">Step {step} of 4</span>\n          </div>\n          <div id=\"progress-meter-bar\" className=\"w-24 h-1.5 bg-slate-100 dark:bg-slate-800 rounded-full overflow-hidden\">\n            <div id=\"progress-indicator\" className=\"h-full bg-emerald-500 transition-all duration-300\" style={{ width: `${(step / 4) * 100}%` }}></div>\n          </div>\n        </div>\n\n        <AnimatePresence mode=\"wait\">\n          {step === 1 && (\n            <motion.div\n              key=\"step1\"\n              initial={{ opacity: 0, x: 10 }}\n              animate={{ opacity: 1, x: 0 }}\n              exit={{ opacity: 0, x: -10 }}\n              transition={{ duration: 0.3 }}\n              id=\"step-1-content animate\"\n            >\n              <h2 className=\"text-2xl font-bold tracking-tight text-slate-909 dark:text-slate-100 mb-2 font-sans flex items-center gap-2\">\n                <User size={24} className=\"text-emerald-500\" /> Let\'s get to know you\n              </h2>\n              <p className=\"text-sm text-slate-500 dark:text-slate-400 mb-6 font-sans\">\n                Tell us about your basic attributes. Your statistics help our system setup baseline daily energy targets.\n              </p>\n\n              {/* Gender input */}\n              <div className=\"mb-6\">\n                <label className=\"block text-xs font-semibold text-slate-500 dark:text-slate-450 uppercase tracking-wider mb-3\">Biological Sex</label>\n                <div className=\"grid grid-cols-3 gap-3\">\n                  {([\'male\', \'female\', \'other\'] as const).map((g) => (\n                    <button\n                      key={g}\n                      onClick={() => setGender(g)}\n                      className={`h-11 rounded-2xl border text-sm font-medium capitalize transition-all cursor-pointer ${\n                        gender === g\n                          ? \'border-emerald-500 bg-emerald-50/40 dark:bg-emerald-900/20 text-emerald-700 dark:text-emerald-400 font-semibold\'\n                          : \'border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-600 dark:text-slate-350\'\n                      }`}\n                    >\n                      {g}\n                    </button>\n                  ))}\n                </div>\n              </div>\n\n              {/* Age input */}\n              <div className=\"mb-6\">\n                <label className=\"block text-xs font-semibold text-slate-500 dark:text-slate-450 uppercase tracking-wider mb-2\">Age (years)</label>\n                <input\n                  type=\"number\"\n                  placeholder=\"e.g. 26\"\n                  value={age}\n                  onChange={(e) => setAge(e.target.value)}\n                  className=\"w-full h-12 px-4 rounded-2xl border border-slate-200 dark:border-slate-800 bg-transparent text-slate-800 dark:text-slate-100 text-sm focus:outline-none focus:ring-1 focus:ring-emerald-500 focus:border-emerald-500\"\n                />\n              </div>\n            </motion.div>\n          )}\n\n          {step === 2 && (\n            <motion.div\n              key=\"step2\"\n              initial={{ opacity: 0, x: 10 }}\n              animate={{ opacity: 1, x: 0 }}\n              exit={{ opacity: 0, x: -10 }}\n              transition={{ duration: 0.3 }}\n              id=\"step-2-content animate\"\n            >\n              <h2 className=\"text-2xl font-bold tracking-tight text-slate-909 dark:text-slate-100 mb-2 font-sans flex items-center gap-2\">\n                <Dumbbell size={24} className=\"text-emerald-500\" /> Body Metrics\n              </h2>\n              <p className=\"text-sm text-slate-500 dark:text-slate-400 mb-6 font-sans\">\n                Please enter your height and weight metrics to calculate your Basal Metabolic Rate (BMR).\n              </p>\n\n              {/* Height input */}\n              <div className=\"mb-6\">\n                <label className=\"block text-xs font-semibold text-slate-500 dark:text-slate-455 uppercase tracking-wider mb-2\">Height (cm)</label>\n                <input\n                  type=\"number\"\n                  placeholder=\"e.g. 175\"\n                  value={height}\n                  onChange={(e) => setHeight(e.target.value)}\n                  className=\"w-full h-12 px-4 rounded-2xl border border-slate-200 dark:border-slate-800 bg-transparent text-slate-800 dark:text-slate-100 text-sm focus:outline-none focus:ring-1 focus:ring-emerald-500 focus:border-emerald-500\"\n                />\n              </div>\n\n              {/* Weight input */}\n              <div className=\"mb-6\">\n                <label className=\"block text-xs font-semibold text-slate-500 dark:text-slate-455 uppercase tracking-wider mb-2\">Weight (kg)</label>\n                <input\n                  type=\"number\"\n                  step=\"0.1\"\n                  placeholder=\"e.g. 72\"\n                  value={weight}\n                  onChange={(e) => setWeight(e.target.value)}\n                  className=\"w-full h-12 px-4 rounded-2xl border border-slate-200 dark:border-slate-800 bg-transparent text-slate-800 dark:text-slate-100 text-sm focus:outline-none focus:ring-1 focus:ring-emerald-500 focus:border-emerald-500\"\n                />\n              </div>\n            </motion.div>\n          )}\n\n          {step === 3 && (\n            <motion.div\n              key=\"step3\"\n              initial={{ opacity: 0, x: 10 }}\n              animate={{ opacity: 1, x: 0 }}\n              exit={{ opacity: 0, x: -10 }}\n              transition={{ duration: 0.3 }}\n              id=\"step-3-content animate\"\n            >\n              <h2 className=\"text-2xl font-bold tracking-tight text-slate-909 dark:text-slate-100 mb-2 font-sans flex items-center gap-2\">\n                <Target size={24} className=\"text-emerald-500\" /> Choose your target\n              </h2>\n              <p className=\"text-sm text-slate-500 dark:text-slate-400 mb-6 font-sans\">\n                What are you looking to achieve? Based on your choice, we calibrate daily calorie restrictions.\n              </p>\n\n              <div className=\"grid grid-cols-1 gap-4 mb-6\">\n                {[\n                  {\n                    id: \'get lean\',\n                    title: \'Get Lean\',\n                    desc: \'Calorie deficit targeting maximum abdominal fat loss while preserving skeletal muscle tissue.\',\n                    icon: \'\360\237\224\245\'\n                  },\n                  {\n                    id: \'maintenance\',\n                    title: \'Maintain Weight\',\n                    desc: \'Perfect energy balance for stable metabolic functioning and performance tracking.\',\n                    icon: \'\342\232\226\357\270\217\'\n                  },\n                  {\n                    id: \'build muscle\',\n                    title: \'Build Muscle\',\n                    desc: \'Slight energy surplus paired with high protein synthesis for strength gains.\',\n                    icon: \'\360\237\222\252\'\n                  }\n                ].map((g) => (\n                  <button\n                    key={g.id}\n                    onClick={() => setGoal(g.id)}\n                    className={`p-4 rounded-2xl border text-left flex items-start gap-3 transition-all cursor-pointer ${\n                      goal === g.id\n                        ? \'border-emerald-500 bg-emerald-50/30 dark:bg-emerald-950/20\'\n                        : \'border-slate-200 dark:border-slate-850 bg-white dark:bg-slate-900 hover:bg-slate-50 dark:hover:bg-slate-850\'\n                    }`}\n                  >\n                    <span className=\"text-2xl mt-0.5 shrink-0\">{g.icon}</span>\n                    <div>\n                      <h4 className={`text-sm font-semibold capitalize ${goal === g.id ? \'text-emerald-900 dark:text-emerald-400 font-bold\' : \'text-slate-850 dark:text-slate-100\'}`}>{g.title}</h4>\n                      <p className=\"text-xs text-slate-500 dark:text-slate-400 mt-1 leading-normal\">{g.desc}</p>\n                    </div>\n                  </button>\n                ))}\n              </div>\n            </motion.div>\n          )}\n\n          {step === 4 && (\n            <motion.div\n              key=\"step4\"\n              initial={{ opacity: 0, scale: 0.98 }}\n              animate={{ opacity: 1, scale: 1 }}\n              transition={{ duration: 0.3 }}\n              id=\"step-4-content animate\"\n            >\n              <div className=\"text-center mb-6\">\n                <div className=\"mx-auto w-12 h-12 bg-emerald-50 dark:bg-emerald-950/30 rounded-2xl flex items-center justify-center text-emerald-600 dark:text-emerald-400 mb-4\">\n                  <Award size={24} />\n                </div>\n                <h2 className=\"text-2xl font-bold tracking-tight text-slate-909 dark:text-slate-100 mb-2 font-sans\">\n                  Your customized blueprint\n                </h2>\n                <p className=\"text-sm text-slate-500 dark:text-slate-400 font-sans max-w-sm mx-auto\">\n                  Based on your statistics, here are your optimized baseline daily macro limits to help you <strong>{goal}</strong>:\n                </p>\n              </div>\n\n              {/* Calculated Targets Overview */}\n              {(() => {\n                const profile = calculateRequirements();\n                return (\n                  <div className=\"bg-slate-50 dark:bg-slate-970/40 border border-slate-100 dark:border-slate-850 rounded-2xl p-6 mb-6\">\n                    {/* Calorie display */}\n                    <div className=\"text-center pb-4 border-b border-slate-100 dark:border-slate-850 mb-4\">\n                      <span className=\"text-xs font-semibold text-slate-400 dark:text-slate-550 uppercase tracking-wider block font-mono\">Daily Caloric Target</span>\n                      <strong className=\"text-4xl font-extrabold tracking-tight text-slate-900 dark:text-white\">{profile.targetCalories}</strong>\n                      <span className=\"text-slate-500 dark:text-slate-400 font-medium text-xs font-mono ml-1\">kcal</span>\n                    </div>\n\n                    {/* Macros Grid */}\n                    <div className=\"grid grid-cols-3 gap-2 text-center\">\n                      <div className=\"bg-white dark:bg-slate-900 border border-slate-100 dark:border-slate-800 p-3 rounded-xl\">\n                        <span className=\"text-[10px] font-semibold text-rose-500 block uppercase tracking-wider font-mono\">Protein</span>\n                        <strong className=\"text-lg font-bold text-slate-800 dark:text-slate-100 block mt-1\">{profile.targetProtein}g</strong>\n                        <span className=\"text-[9px] text-slate-400 dark:text-slate-500 font-mono\">4 kcal/g</span>\n                      </div>\n                      <div className=\"bg-white dark:bg-slate-900 border border-slate-100 dark:border-slate-800 p-3 rounded-xl\">\n                        <span className=\"text-[10px] font-semibold text-amber-500 block uppercase tracking-wider font-mono\">Carbs</span>\n                        <strong className=\"text-lg font-bold text-slate-800 dark:text-slate-100 block mt-1\">{profile.targetCarbs}g</strong>\n                        <span className=\"text-[9px] text-slate-400 dark:text-slate-500 font-mono\">4 kcal/g</span>\n                      </div>\n                      <div className=\"bg-white dark:bg-slate-900 border border-slate-100 dark:border-slate-800 p-3 rounded-xl\">\n                        <span className=\"text-[10px] font-semibold text-sky-500 block uppercase tracking-wider font-mono\">Fats</span>\n                        <strong className=\"text-lg font-bold text-slate-800 dark:text-slate-100 block mt-1\">{profile.targetFat}g</strong>\n                        <span className=\"text-[9px] text-slate-400 dark:text-slate-500 font-mono\">9 kcal/g</span>\n                      </div>\n                    </div>\n                  </div>\n                );\n              })()}\n            </motion.div>\n          )}\n        </AnimatePresence>\n\n        {/* Error notification banner */}\n        {errorString && (\n          <motion.div\n            initial={{ opacity: 0, y: -5 }}\n            animate={{ opacity: 1, y: 0 }}\n            className=\"p-3 bg-red-50 dark:bg-red-950/20 border border-red-100 dark:border-red-900/30 rounded-xl mb-6 text-xs text-red-600 dark:text-red-400 text-center font-medium\"\n          >\n            {errorString}\n          </motion.div>\n        )}\n\n        {/* Navigation Action Buttons footer */}\n        <div id=\"onboarding-actions\" className=\"flex items-center justify-between gap-3 mt-8\">\n          {step > 1 && step < 4 && (\n            <button\n              onClick={handleBack}\n              className=\"px-4 h-11 border border-slate-200 dark:border-slate-800 text-slate-600 dark:text-slate-300 rounded-xl flex items-center justify-center gap-1.5 text-sm hover:bg-slate-50 dark:hover:bg-slate-805 cursor-pointer transition-colors\"\n            >\n              <ChevronLeft size={16} />\n              <span>Back</span>\n            </button>\n          )}\n\n          <div className=\"flex-1\"></div>\n\n          {step < 4 ? (\n            <button\n              onClick={handleNext}\n              className=\"px-5 h-11 bg-slate-900 dark:bg-slate-800 text-white rounded-xl flex items-center justify-center gap-1.5 text-sm font-medium hover:bg-slate-850 dark:hover:bg-slate-705 cursor-pointer transition-colors\"\n            >\n              <span>Continue</span>\n              <ChevronRight size={16} />\n            </button>\n          ) : (\n            <div className=\"flex w-full gap-3\">\n              <button\n                onClick={() => setStep(3)}\n                className=\"px-4 h-11 border border-slate-200 dark:border-slate-800 text-slate-600 dark:text-slate-300 rounded-xl text-sm hover:bg-slate-50 dark:hover:bg-slate-800 cursor-pointer transition-colors\"\n              >\n                Change Target\n              </button>\n              <button\n                onClick={handleSubmit}\n                className=\"flex-1 h-11 bg-emerald-600 text-white rounded-xl text-sm font-semibold hover:bg-emerald-700 cursor-pointer transition-colors\"\n              >\n                Let\'s Begin Tracking!\n              </button>\n            </div>\n          )}\n        </div>\n\n      </div>\n    </div>\n  );\n}"
