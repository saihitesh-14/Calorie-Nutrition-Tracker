      fuzzy_match: "    </div>\n\n        {/* Logs breakdown per daily meal category (Bottom Block) */}\n        <div className=\"grid grid-cols-1 md:grid-cols-2 gap-6 pb-8\">\n          \n          {/* Section 1: Meals breakdown */}\n          <div className=\"bg-white border border-slate-150/70 rounded-3xl p-6 shadow-xs flex flex-col justify-between\">\n            <div className=\"mb-4\">\n              <h3 className=\"font-bold text-slate-800 text-sm\">Meal Journal Breakdown</h3>\n              <p className=\"text-xs text-slate-400 font-mono mt-0.5\">LOGS RECORDED FOR {selectedDateFilter}</p>\n            </div>\n\n            {/* List by meal categories */}\n            <div className=\"space-y-3 flex-1 min-h-[300px]\">\n              {mealCategories.map((cat) => {\n                const categoryLogs = filteredLogs.filter(l => l.mealType === cat.type);\n                const categoryCalories = categoryLogs.reduce((sum, item) => sum + item.calories, 0);\n\n                return (\n                  <div key={cat.type} className=\"border border-slate-100 rounded-2xl overflow-hidden transition-all hover:shadow-xs\">\n                    \n                    {/* Header bar */}\n                    <div className=\"bg-slate-50/50 px-4 py-2.5 flex items-center justify-between border-b border-slate-100\">\n                      <div className=\"flex items-center gap-1.5\">\n                        <span className=\"text-base shrink-0\">{cat.icon}</span>\n                        <span className=\"font-bold text-slate-800 text-xs\">{cat.name}</span>\n                      </div>\n                      <span className=\"text-[10px] font-mono text-slate-500\">\n                        {categoryCalories} kcal total\n                      </span>\n                    </div>\n\n                    {/* Content item list */}\n                    <div className=\"divide-y divide-slate-100/60 bg-white\">\n                      {categoryLogs.length === 0 ? (\n                        <div className=\"p-3 text-center text-slate-400 text-[11px] italic\">\n                          No {cat.name.toLowerCase()} items logged.\n                        </div>\n                      ) : (\n                        categoryLogs.map((log) => (\n                          <div \n                            key={log.id} \n                            onClick={() => setSelectedLogForDetails(log)}\n                            className=\"p-3 flex items-center justify-between gap-3 hover:bg-slate-50/50 cursor-pointer transition-colors\"\n                          >\n                            <div className=\"flex items-center gap-3\">\n                              {log.imageUrl ? (\n                                <img \n                                  src={log.imageUrl} \n                                  alt=\"Meal log\" \n                                  className=\"w-10 h-10 rounded-lg object-cover bg-slate-100 shrink-0 border border-slate-200\"\n                                  referrerPolicy=\"no-referrer\"\n                                />\n                              ) : (\n                                <div className=\"w-10 h-10 rounded-lg bg-slate-100 shrink-0 border border-slate-150 flex items-center justify-center text-xs\">\n                                  \360\237\245\227\n                                </div>\n                              )}\n                              <div className=\"min-w-0\">\n                                <h4 className=\"font-semibold text-slate-700 text-xs truncate max-w-[150px]\">{log.foodName}</h4>\n                                <span className=\"text-[9px] text-slate-400 font-mono\">\n                                  P: {log.protein}g \302\267 C: {log.carbs}g \302\267 F: {log.fat}g\n                                </span>\n                              </div>\n                            </div>\n\n                            <div className=\"flex items-center gap-2\">\n                              <span className=\"font-bold text-slate-800 text-xs font-mono\">{log.calories} kcal</span>\n                              \n                              {deletingLogId === log.id ? (\n                                <div className=\"flex items-center gap-1 bg-rose-50/50 p-0.5 rounded-lg border border-rose-100/60\" onClick={(e) => e.stopPropagation()}>\n                                  <span className=\"text-[10px] text-rose-600 font-semibold px-1.5 font-sans\">Delete?</span>\n                                  <button\n                                    onClick={async (e) => {\n                                      e.stopPropagation();\n                                      await onDeleteLog(log.id);\n                                      if (selectedLogForDetails?.id === log.id) {\n                                        setSelectedLogForDetails(null);\n                                      }\n                                      setDeletingLogId(null);\n                                    }}\n                                    className=\"w-6 h-6 rounded-md bg-rose-600 text-white flex items-center justify-center hover:bg-rose-700 transition-colors cursor-pointer shadow-xs\"\n                                    title=\"Confirm delete\"\n                                  >\n                                    <Check size={12} strokeWidth={2.5} />\n                                  </button>\n                                  <button\n                                    onClick={(e) => {\n                                      e.stopPropagation();\n                                      setDeletingLogId(null);\n                                    }}\n                                    className=\"w-6 h-6 rounded-md bg-slate-100 text-slate-500 flex items-center justify-center hover:bg-slate-200 transition-colors cursor-pointer\"\n                                    title=\"Cancel\"\n                                  >\n                                    <X size={12} strokeWidth={2.5} />\n                                  </button>\n                                </div>\n                              ) : (\n                                <button\n                                  onClick={(e) => {\n                                    e.stopPropagation();\n                                    setDeletingLogId(log.id);\n                                  }}\n                                  className=\"w-7 h-7 rounded-lg hover:bg-rose-50 hover:text-rose-600 border border-transparent hover:border-rose-100 flex items-center justify-center text-slate-400 transition-all cursor-pointer\"\n                                  title=\"Delete item\"\n                                >\n                                  <Trash2 size={13} />\n                                </button>\n                              )}\n                            </div>\n                          </div>\n                        ))\n                      )}\n                    </div>\n\n                  </div>\n                );\n              })}\n            </div>\n          </div>\n\n          {/* Section 2: Interactive Ingredients sidebar panel / Helper metrics */}\n          <div className=\"bg-white border border-slate-150/70 rounded-3xl p-6 shadow-xs flex flex-col justify-between\">\n            <div>\n              <h3 className=\"font-bold text-slate-800 text-sm\">Ingredients & Nutritional Extract</h3>\n              <p className=\"text-xs text-slate-400 font-mono mt-0.5\">CLICK A LOG ON THE JOURNAL TO INSPECT COMPONENTS</p>\n            </div>\n\n            {selectedLogForDetails ? (\n              <div className=\"space-y-5 my-auto py-4 animate-fadeIn\">\n                <div className=\"flex items-center justify-between border-b border-slate-100 pb-3\">\n                  <div>\n                    <h4 className=\"font-bold text-slate-800 text-sm\">{selectedLogForDetails.foodName}</h4>\n                    <span className=\"text-[10px] text-emerald-600 font-mono uppercase bg-emerald-50 border border-emerald-100 px-2 py-0.5 rounded-md mt-1 inline-block\">\n                      {selectedLogForDetails.mealType}\n                    </span>\n                  </div>\n                  <strong className=\"text-lg font-black text-slate-800 font-mono\">\n                    {selectedLogForDetails.calories} <span className=\"text-xs font-normal text-slate-400\">kcal</span>\n                  </strong>\n                </div>\n\n                {/* Macromols breakdown summary */}\n                <div className=\"grid grid-cols-3 gap-2 text-center text-xs\">\n                  <div className=\"bg-rose-50/20 border border-rose-100/50 p-2 rounded-xl\">\n                    <span className=\"text-[10px] text-rose-500 block uppercase font-mono tracking-wider\">Protein</span>\n                    <strong className=\"font-bold text-slate-700 mt-0.5 block\">{selectedLogForDetails.protein}g</strong>\n                  </div>\n                  <div className=\"bg-amber-50/20 border border-amber-100/50 p-2 rounded-xl\">\n                    <span className=\"text-[10px] text-amber-600 block uppercase font-mono tracking-wider\">Carbs</span>\n                    <strong className=\"font-bold text-slate-700 mt-0.5 block\">{selectedLogForDetails.carbs}g</strong>\n                  </div>\n                  <div className=\"bg-sky-50/20 border border-sky-100/50 p-2 rounded-xl\">\n                    <span className=\"text-[10px] text-sky-600 block uppercase font-mono tracking-wider\">Fat</span>\n                    <strong className=\"font-bold text-slate-700 mt-0.5 block\">{selectedLogForDetails.fat}g</strong>\n                  </div>\n                </div>\n\n                {/* Sub-components items box */}\n                <div>\n                  <span className=\"text-[10px] uppercase font-mono tracking-wider text-slate-400 font-bold block mb-1.5\">\n                    Ingredients Detected by Gemini\n                  </span>\n                  <div className=\"flex flex-wrap gap-1.5 p-4 bg-slate-50 border border-slate-100 rounded-2xl min-h-12 max-h-[160px] overflow-y-auto\">\n                    {selectedLogForDetails.ingredients && selectedLogForDetails.ingredients.length > 0 ? (\n                      selectedLogForDetails.ingredients.map((item, key) => (\n                        <span \n                          key={key} \n                          className=\"px-2.5 py-1 bg-white border border-slate-200 rounded-lg text-xs font-semibold text-slate-600 flex items-center gap-1 shadow-2xs\"\n                        >\n                          <span className=\"w-1 h-1 rounded-full bg-emerald-500\"></span> {item}\n                        </span>\n                      ))\n                    ) : (\n                      <p className=\"text-slate-400 text-xs italic\">No detailed ingredients available for this manual log.</p>\n                    )}\n                  </div>\n                </div>\n\n                <div className=\"text-right\">\n                  <button\n                    onClick={() => setSelectedLogForDetails(null)}\n                    className=\"text-xs text-slate-400 hover:text-slate-600 font-medium underline cursor-pointer\"\n                  >\n                    Clear Selection\n                  </button>\n                </div>\n              </div>\n            ) : (\n              <div className=\"flex-1 flex flex-col items-center justify-center text-center p-8 text-slate-400 space-y-2 min-h-[300px]\">\n                <div className=\"w-12 h-12 bg-slate-50 border border-slate-100 rounded-xl flex items-center justify-center text-slate-350\">\n                  <Info size={20} />\n                </div>\n                <h4 className=\"text-xs font-semibold text-slate-600\">No Meal Selected</h4>\n                <p className=\"text-[11px] leading-normal text-slate-400 max-w-xs\">\n                  Click on any meal card in the Journal log break-ups list to view full ingredients details.\n                </p>\n              </div>\n            )}\n          </div"
