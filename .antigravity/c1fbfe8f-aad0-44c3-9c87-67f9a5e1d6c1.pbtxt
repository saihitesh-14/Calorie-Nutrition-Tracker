  file_change {
    absolute_path_uri: "file:///firestore.rules"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "rules_version = \'2\';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n\n    // Global Safety Net\n    match /{document=**} {\n      allow read, write: if false;\n    }\n\n    // Common Helpers\n    function isSignedIn() {\n      return request.auth != null;\n    }\n\n    function isValidId(id) {\n      return id is string && id.size() <= 128 && id.matches(\'^[a-zA-Z0-9_\\\\-]+$\');\n    }\n\n    // Extract incoming/existing resource state\n    function incoming() {\n      return request.resource.data;\n    }\n\n    function existing() {\n      return resource.data;\n    }\n\n    // User Entity Verification\n    function isValidUser(data) {\n      return data.keys().hasAll([\'userId\', \'age\', \'height\', \'weight\', \'goal\', \'targetCalories\', \'targetProtein\', \'targetCarbs\', \'targetFat\', \'updatedAt\'])\n        && data.keys().size() == 10\n        && data.userId == request.auth.uid\n        && data.age is int && data.age >= 0 && data.age <= 120\n        && data.height is int && data.height >= 0 && data.height <= 300\n        && data.weight is int && data.weight >= 0 && data.weight <= 500\n        && data.goal is string && data.goal.size() <= 100\n        && data.targetCalories is int && data.targetCalories >= 0 && data.targetCalories <= 20000\n        && data.targetProtein is int && data.targetProtein >= 0 && data.targetProtein <= 2000\n        && data.targetCarbs is int && data.targetCarbs >= 0 && data.targetCarbs <= 2000\n        && data.targetFat is int && data.targetFat >= 0 && data.targetFat <= 1000\n        && data.updatedAt is string && data.updatedAt.size() <= 128;\n    }\n\n    // Log Entity Verification\n    function isValidLog(data) {\n      return data.keys().hasAll([\'id\', \'userId\', \'foodName\', \'mealType\', \'calories\', \'protein\', \'carbs\', \'fat\', \'loggedAt\', \'createdAt\'])\n        && data.keys().size() >= 10 && data.keys().size() <= 12\n        && data.id is string && data.id.size() <= 128\n        && data.userId == request.auth.uid\n        && data.foodName is string && data.foodName.size() <= 200\n        && data.mealType is string && (data.mealType == \'breakfast\' || data.mealType == \'lunch\' || data.mealType == \'dinner\' || data.mealType == \'snack\')\n        && data.calories is int && data.calories >= 0 && data.calories <= 10000\n        && data.protein is int && data.protein >= 0 && data.protein <= 1000\n        && data.carbs is int && data.carbs >= 0 && data.carbs <= 1000\n        && data.fat is int && data.fat >= 0 && data.fat <= 500\n        && (!(\'ingredients\' in data) || (data.ingredients is list && data.ingredients.size() <= 50 && (data.ingredients.size() == 0 || data.ingredients[0] is string)))\n        && (!(\'imageUrl\' in data) || (data.imageUrl is string && data.imageUrl.size() <= 5000))\n        && data.loggedAt is string && data.loggedAt.size() <= 128\n        && data.createdAt is string && data.createdAt.size() <= 128;\n    }\n\n    match /users/{userId} {\n      allow get: if isSignedIn() && request.auth.uid == userId;\n      allow create, update: if isSignedIn() && request.auth.uid == userId && isValidUser(incoming());\n      allow delete: if isSignedIn() && request.auth.uid == userId;\n\n      match /logs/{logId} {\n        allow get, list: if isSignedIn() && request.auth.uid == userId;\n        allow create: if isSignedIn() && request.auth.uid == userId && isValidId(logId) && isValidLog(incoming());\n        allow update: if isSignedIn() && request.auth.uid == userId && isValidId(logId) && isValidLog(incoming());\n        allow delete: if isSignedIn() && request.auth.uid == userId && isValidId(logId);\n      }\n    }\n  }\n}\n"
    }
