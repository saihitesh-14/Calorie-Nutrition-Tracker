        target_content: "export default function App() {\n  // Auth state monitoring\n  const [user, setUser] = useState<FirebaseUser | null>(null);\n  const [profile, setProfile] = useState<UserProfile | null>(null);\n  const [logs, setLogs] = useState<FoodLog[]>([]);\n  \n  // Loading transitions\n  const [isAuthLoading, setIsAuthLoading] = useState(true);\n  const [isDataLoading, setIsDataLoading] = useState(false);\n  const [isActionLoading, setIsActionLoading] = useState(false);\n\n  // Overlay trigger toggles\n  const [isLoggerOpen, setIsLoggerOpen] = useState(false);"
        replacement_content: "export default function App() {\n  // Theme state: light or dark\n  const [theme, setTheme] = useState<\'light\' | \'dark\'>(() => {\n    return (localStorage.getItem(\'nutriflow-theme\') as \'light\' | \'dark\') || \'light\';\n  });\n\n  // Auth state monitoring\n  const [user, setUser] = useState<FirebaseUser | null>(null);\n  const [profile, setProfile] = useState<UserProfile | null>(null);\n  const [logs, setLogs] = useState<FoodLog[]>([]);\n  \n  // Loading transitions\n  const [isAuthLoading, setIsAuthLoading] = useState(true);\n  const [isDataLoading, setIsDataLoading] = useState(false);\n  const [isActionLoading, setIsActionLoading] = useState(false);\n\n  // Overlay trigger toggles\n  const [isLoggerOpen, setIsLoggerOpen] = useState(false);\n\n  // Theme Sync on load & toggle\n  useEffect(() => {\n    const root = window.document.documentElement;\n    if (theme === \'dark\') {\n      root.classList.add(\'dark\');\n    } else {\n      root.classList.remove(\'dark\');\n    }\n    localStorage.setItem(\'nutriflow-theme\', theme);\n  }, [theme]);\n\n  const toggleTheme = () => {\n    setTheme(prev => prev === \'light\' ? \'dark\' : \'light\');\n  };"
      }
      num_matches: 1
    }
  }
